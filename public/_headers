/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://static.cloudflareinsights.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com; img-src 'self' data: https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com https://dearrow-thumb.ajay.app; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; object-src 'none'

# Build output (hashed scripts and styles): cache forever, keep out of search indexes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

# Decorative icons: crawlable (pages need them to render) but not indexed.
/brand/favicon-*
  X-Robots-Tag: noindex
/brand/icon-*
  X-Robots-Tag: noindex
/brand/apple-touch-icon.png
  X-Robots-Tag: noindex
/brand/logo-*
  X-Robots-Tag: noindex
/favicon.ico
  X-Robots-Tag: noindex
/favicon.svg
  X-Robots-Tag: noindex
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  X-Robots-Tag: noindex
/opensearch.xml
  Content-Type: application/opensearchdescription+xml; charset=utf-8
  X-Robots-Tag: noindex

# Machine-readable files: readable by people and bots, short cache so edits roll out.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/brand/*
  Cache-Control: public, max-age=604800
