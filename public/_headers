/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com https://static.cloudflareinsights.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; img-src 'self' data: https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com https://dearrow-thumb.ajay.app; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cloudflareinsights.com https://www.googleapis.com https://accounts.spotify.com https://api.spotify.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; object-src 'none'

# Community-plugin sandbox: its own locked-down policy instead of the site's. The page is
# framed with sandbox="allow-scripts" (opaque origin); the CSP sandbox makes that hold even if
# it's opened directly, and default-src 'none' leaves plugin code no network at all.
/plugin-sandbox*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; worker-src blob:; frame-ancestors 'self'; sandbox allow-scripts
  X-Robots-Tag: noindex

# In-app updater (BetterYTS Music sideload build): the manifest is always fresh, APKs are versioned.
/app/update.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex
/app/*.apk
  Content-Type: application/vnd.android.package-archive
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

# Build output (hashed scripts and styles): cache forever, keep out of search indexes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

# Decorative icons: crawlable (pages need them to render) but not indexed.
/brand/favicon-*
  X-Robots-Tag: noindex
/brand/icon-*
  X-Robots-Tag: noindex
/brand/apple-touch-icon.png
  X-Robots-Tag: noindex
/brand/logo-*
  X-Robots-Tag: noindex
/favicon.ico
  X-Robots-Tag: noindex
/favicon.svg
  X-Robots-Tag: noindex
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  X-Robots-Tag: noindex
/opensearch.xml
  Content-Type: application/opensearchdescription+xml; charset=utf-8
  X-Robots-Tag: noindex

# Machine-readable files: readable by people and bots, short cache so edits roll out.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/brand/*
  Cache-Control: public, max-age=604800
